# Supabase project settings (Dashboard -> Project Settings -> API).
# Only the anon/public key goes here. Never put the service_role key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only keys for the MCP server (npm run mcp:dev). Put real values in .env.local, never here,
# and never as EXPO_PUBLIC_*. In production these are Vercel environment variables.
# SUPABASE_SECRET_KEY=sb_secret_your-secret-key
# FDC_API_KEY=your-usda-api-key
